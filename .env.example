# Variables públicas: se incrustan en el sitio estático. Nunca pongas secretos aquí.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Solo para el build, si el dataset de Sanity es privado.
SANITY_READ_TOKEN=

# true solo en el despliegue a GitHub Pages (activa basePath).
GITHUB_PAGES=

# URL pública del sitio (para enlaces absolutos, Open Graph y sitemap). Ejemplo: https://usuario.github.io/coffee-santander-shop
NEXT_PUBLIC_SITE_URL=
